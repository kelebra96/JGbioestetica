<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Contato - Gratieri Clínica Bioestética' %></title>
    <meta name="description" content="Entre em contato com a Gratieri Clínica Bioestética em Taquatiringa-SP. WhatsApp: (16) 99963-3163. Agende sua consulta.">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/accessibility.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #F5F5DC;
        }

        /* Header Section */
        .header-section {
            background: linear-gradient(rgba(85, 107, 47, 0.8), rgba(85, 107, 47, 0.8)),
                        url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80');
            background-size: cover;
            background-position: center;
            padding: 4rem 2rem;
            text-align: center;
            color: white;
        }

        .header-title {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .header-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Main Content */
        .main-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 2rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: start;
        }

        /* Contact Form */
        .contact-form-section {
            background: white;
            padding: 3rem;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .form-title {
            font-size: 2rem;
            color: #556B2F;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            color: #556B2F;
            font-weight: bold;
        }

        .form-input,
        .form-textarea,
        .form-select {
            width: 100%;
            padding: 1rem;
            border: 2px solid #EDE5B0;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
            background-color: #FAFAFA;
        }

        .form-input:focus,
        .form-textarea:focus,
        .form-select:focus {
            outline: none;
            border-color: #556B2F;
            background-color: white;
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .submit-button {
            background-color: #556B2F;
            color: white;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #4A5E28;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* Contact Info */
        .contact-info-section {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .contact-info-card {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .info-title {
            font-size: 1.5rem;
            color: #556B2F;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            padding: 0.5rem 0;
        }

        .info-icon {
            font-size: 1.5rem;
            color: #E2B850;
            width: 30px;
            text-align: center;
        }

        .info-text {
            color: #666;
            line-height: 1.5;
        }

        .info-text strong {
            color: #556B2F;
        }

        /* Map Section */
        .map-section {
            margin-top: 4rem;
            padding: 0 2rem;
        }

        .map-container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .map-header {
            padding: 2rem;
            background-color: #556B2F;
            color: white;
            text-align: center;
        }

        .map-title {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        .map-subtitle {
            opacity: 0.9;
        }

        .map-embed {
            width: 100%;
            height: 400px;
            border: none;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .header-title {
                font-size: 2rem;
            }

            .main-content {
                grid-template-columns: 1fr;
                gap: 2rem;
                padding: 2rem 1rem;
            }

            .contact-form-section {
                padding: 2rem;
            }

            .form-title {
                font-size: 1.5rem;
            }

            .map-section {
                padding: 0 1rem;
            }

            .map-header {
                padding: 1.5rem;
            }

            .map-title {
                font-size: 1.4rem;
            }

            .map-embed {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <!-- Header Section -->
    <section class="header-section" role="region" aria-label="Banner principal">
        <h1 class="header-title">Entre em Contato</h1>
        <p class="header-subtitle">
            Estamos prontos para ajudar você a realçar sua beleza natural.
            Entre em contato conosco e agende sua consulta personalizada.
        </p>
    </section>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Contact Form -->
        <div class="contact-form-section">
            <h2 class="form-title" id="form-title">Envie sua Mensagem</h2>
            <form id="contactForm" action="/contact" method="POST" aria-labelledby="form-title">
                <div class="form-group">
                    <label for="name" class="form-label">Nome Completo *</label>
                    <input type="text" id="name" name="name" class="form-input" required aria-required="true" autocomplete="name">
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">E-mail *</label>
                    <input type="email" id="email" name="email" class="form-input" required aria-required="true" autocomplete="email">
                </div>

                <div class="form-group">
                    <label for="phone" class="form-label">Telefone/WhatsApp</label>
                    <input type="tel" id="phone" name="phone" class="form-input" placeholder="(11) 99999-9999" autocomplete="tel">
                </div>

                <div class="form-group">
                    <label for="service" class="form-label">Serviço de Interesse</label>
                    <select id="service" name="service" class="form-select">
                        <option value="">Selecione um serviço</option>
                        <option value="laser">Revitalização da Pele a Laser</option>
                        <option value="depilacao-laser">Depilação a Laser</option>
                        <option value="harmonizacao-facial">Harmonização Facial</option>
                        <option value="remocao-tatuagem">Remoção de Tatuagem</option>
                        <option value="peeling">Peeling Químico</option>
                        <option value="co2-fracionado">CO2 Fracionado</option>
                        <option value="lavieen">Laser Lavieen</option>
                        <option value="outros">Outros</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="message" class="form-label">Mensagem *</label>
                    <textarea id="message" name="message" class="form-textarea"
                              placeholder="Conte-nos sobre suas necessidades e dúvidas..." required aria-required="true"></textarea>
                </div>

                <button type="submit" class="submit-button" aria-label="Enviar formulário de contato">Enviar Mensagem</button>
            </form>
        </div>

        <!-- Contact Information -->
        <div class="contact-info-section">
            <div class="contact-info-card">
                <h3 class="info-title">
                    <span class="info-icon">📍</span>
                    Localização
                </h3>
                <div class="info-item">
                    <span class="info-icon">🏢</span>
                    <div class="info-text">
                        <strong>Endereço:</strong><br>
                        R. Sete de setembro, 666<br>
                        Taquatiringa - SP
                    </div>
                </div>
            </div>

            <div class="contact-info-card">
                <h3 class="info-title">
                    <span class="info-icon">📞</span>
                    Contato
                </h3>
                <div class="info-item">
                    <span class="info-icon">📱</span>
                    <div class="info-text">
                        <strong>WhatsApp:</strong><br>
                        <a href="https://wa.me/5516999633163" target="_blank" rel="noopener noreferrer">(16) 99963-3163</a>
                    </div>
                </div>
                <div class="info-item">
                    <span class="info-icon">👩‍⚕️</span>
                    <div class="info-text">
                        <strong>Profissional:</strong><br>
                        Joice Gratieri
                    </div>
                </div>
            </div>

            <div class="contact-info-card">
                <h3 class="info-title">
                    <span class="info-icon">⏰</span>
                    Horário de Funcionamento
                </h3>
                <div class="info-item">
                    <span class="info-icon">📅</span>
                    <div class="info-text">
                        <strong>Segunda a Sexta:</strong><br>
                        08:00 às 18:00
                    </div>
                </div>
                <div class="info-item">
                    <span class="info-icon">📅</span>
                    <div class="info-text">
                        <strong>Sábado:</strong><br>
                        08:00 às 14:00
                    </div>
                </div>
                <div class="info-item">
                    <span class="info-icon">🚫</span>
                    <div class="info-text">
                        <strong>Domingo:</strong><br>
                        Fechado
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <section class="map-section" role="region" aria-labelledby="map-title">
        <div class="map-container">
            <div class="map-header">
                <h2 class="map-title" id="map-title">Nossa Localização</h2>
                <p class="map-subtitle">Venha nos visitar! Estamos bem localizados e com fácil acesso.</p>
            </div>
            <iframe
                class="map-embed"
                src="https://maps.google.com/maps?q=R.+Sete+de+setembro,+666+Taquaritinga+-+SP&t=&z=15&ie=UTF8&iwloc=&output=embed"
                allowfullscreen=""
                loading="lazy"
                title="Mapa da localização da JG Bioestética"
                aria-label="Mapa mostrando a localização da clínica JG Bioestética na R. Sete de setembro, 666 - Taquaritinga - SP"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </section>

    <script>
        // Form submission handler (placeholder for future implementation)
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // Basic form validation
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const message = document.getElementById('message').value.trim();

            if (!name || !email || !message) {
                alert('Por favor, preencha todos os campos obrigatórios.');
                return;
            }

            // For now, just show a success message
            // In the future, this will be connected to backend form handling
            alert('Mensagem enviada com sucesso! Entraremos em contato em breve.');
            this.reset();
        });

        // Phone number formatting
        document.getElementById('phone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length >= 11) {
                value = value.replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3');
            } else if (value.length >= 7) {
                value = value.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
            } else if (value.length >= 3) {
                value = value.replace(/(\d{2})(\d{0,5})/, '($1) $2');
            }
            e.target.value = value;
        });
    </script>

    <%- include('partials/footer') %>

    <script src="/js/mobile-menu.js"></script>
    <script src="/js/accessibility.js"></script>
</body>
</html>